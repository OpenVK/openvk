var dlgs = API.messages.getDialogs({
    "offset": parseInt(Args.offset),
    "count": parseInt(Args.count),
    "preview_length": 60
});

var uids = [];
var wrappedItems = [];
var rawItems = [];
var totalCount = 0;

if (dlgs) {
    if (dlgs.items) {
        rawItems = dlgs.items;
        totalCount = dlgs.count;
    } else if (dlgs.length) {
        var startIdx = 0;
        if (typeof dlgs[0] == "number" || typeof dlgs[0] == "string") {
            totalCount = parseInt(dlgs[0]);
            startIdx = 1;
        } else {
            totalCount = dlgs.length;
            startIdx = 0;
        }
        var k = startIdx;
        while (k < dlgs.length) {
            rawItems.push(dlgs[k]);
            k = k + 1;
        }
    }
}

if (rawItems && rawItems.length > 0) {
    var i = 0;
    while (i < rawItems.length) {
        var item = rawItems[i];
        var msg = null;
        var unread = 0;

        // Если обертки message нет, используем сам item как сообщение
        if (item.message) {
            msg = item.message;
            unread = item.unread;
        } else {
            msg = item;
            if (item.read_state == 0 && item.out == 0) {
                unread = 1;
            }
        }

        if (msg) {
            wrappedItems.push({
                "unread": unread,
                "message": msg
            });

            if (msg.user_id > 0) {
                uids.push(msg.user_id);
            }
            if (msg.admin_id && msg.admin_id > 0) {
                uids.push(msg.admin_id);
            }
            if (msg.chat_active) {
                var j = 0;
                while (j < msg.chat_active.length && j < 6) {
                    if (msg.chat_active[j] > 0) {
                        uids.push(msg.chat_active[j]);
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
}

var profiles = [];
if (uids.length > 0) {
    profiles = API.users.get({
        "user_ids": uids,
        "fields": "photo_rec,photo_medium_rec,photo_50,photo_100,online"
    });
}

return {
    "a": {
        "count": totalCount,
        "items": wrappedItems
    },
    "p": profiles
};