var reqs = API.friends.getRequests({
    "offset": Args.offset,
    "count": Args.count,
    "extended": 1,
    "need_mutual": 1,
    "suggested": Args.suggested
});
var uids = [];
if (reqs && reqs.items) {
    var i = 0;
    while (i < reqs.items.length) {
        uids.push(reqs.items[i].user_id);
        i = i + 1;
    }
}
var profiles = [];
if (uids.length > 0) {
    profiles = API.users.get({
        "user_ids": uids.join(","),
        "fields": "photo_50,photo_100,photo_rec,photo_medium_rec,online,university_name,graduation,city,country"
    });
}
return {
    "f": reqs && reqs.items ? reqs.items : [],
    "p": profiles,
    "s_from": []
};
