"tour_section_1_title_1" = "Mulai dari mana?";
"tour_section_1_text_1" = "Mendaftarkan akun adalah langkah pertama dan paling dasar untuk memulai perjalanan Anda di situs ini.";
"tour_section_1_text_2" = "Untuk mendaftar, Anda perlu memasukkan nama, email, dan kata sandi.";
"tour_section_1_text_3" = "<b>Ingat:</b> Email Anda akan digunakan sebagai nama pengguna untuk masuk ke situs. Anda juga sepenuhnya berhak untuk tidak mencantumkan nama belakang saat mendaftar. Jika Anda lupa kata sandi untuk masuk ke situs, gunakan <a href='/restore'>halaman pemulihan</a>";
"tour_section_1_bottom_text_1" = "Dengan mendaftar di situs ini, Anda menyetujui <a href='/terms'>peraturan situs</a> dan <a href='/privacy'>kebijakan privasi</a>";
"tour_section_2_title_1" = "Profil Anda";
"tour_section_2_text_1_1" = "Setelah mendaftar, Anda akan otomatis diarahkan ke <b>profil Anda</b>.";
"tour_section_2_text_1_2" = "Anda dapat mengeditnya kapan saja dan dari mana saja.";
"tour_section_2_text_1_3" = "<b>Petunjuk:</b> Untuk mempercantik tampilan profil, pertimbangkan untuk mengisinya dengan informasi atau mengunggah foto yang mencerminkan dunia batin Anda.";
"tour_section_2_bottom_text_1" = "Anda yang menentukan seberapa banyak informasi yang ingin dibagikan kepada teman-teman Anda.";
"tour_section_2_title_2" = "Atur Pengaturan Privasi Anda";
"tour_section_2_text_2_1" = "Tentukan siapa yang dapat mengakses jenis informasi dan bagian tertentu di halaman Anda.";
"tour_section_2_text_2_2" = "Anda dapat memblokir akses ke halaman Anda dari mesin pencari dan pengguna yang belum terdaftar.";
"tour_section_2_text_2_3" = "<b>Ingat:</b> Pengaturan privasi akan diperluas pada masa mendatang.";
"tour_section_2_title_3" = "URL Profil";
"tour_section_2_text_3_1" = "Setelah mendaftar, halaman Anda akan diberi ID pribadi seperti <b>@id12345</b>.";
"tour_section_2_text_3_2" = "<b>ID bawaan</b> yang diperoleh saat pendaftaran <b>tidak dapat diubah</b>.";
"tour_section_2_text_3_3" = "Namun, di pengaturan halaman, Anda dapat menghubungkan alamat pribadi yang <b>dapat diubah</b> kapan saja.";
"tour_section_2_text_3_4" = "<b>Petunjuk:</b> Pilih alamat dengan panjang minimal 5 karakter untuk URL yang keren :)";
"tour_section_2_bottom_text_2" = "<i>Mendukung alamat singkat apa pun yang ditulis dalam huruf Latin kecil; alamat dapat berisi angka (bukan di awal), titik, dan garis bawah (bukan di awal atau akhir)</i>";
"tour_section_2_title_4" = "Dinding";
"tour_section_3_title_1" = "Bagikan Momen Foto Anda";
"tour_section_3_text_1" = "Bagian “Foto” tersedia di profil Anda segera setelah Anda mendaftar.";
"tour_section_3_text_2" = "Jelajahi album foto pengguna dan buat album Anda sendiri.";
"tour_section_3_text_3" = "Atur akses pengguna lain ke semua album foto Anda melalui pengaturan privasi halaman.";
"tour_section_3_bottom_text_1" = "Buat album foto dalam jumlah tak terbatas untuk perjalanan, acara, atau sekadar menyimpan meme.";
"tour_section_4_title_1" = "Pencarian";
"tour_section_4_text_1" = "Bagian “Pencarian” memungkinkan Anda mencari pengguna dan grup.";
"tour_section_4_text_2" = "Bagian situs ini akan terus disempurnakan seiring waktu.";
"tour_section_4_text_3" = "Untuk memulai pencarian, Anda perlu mengetahui nama depan atau nama belakang pengguna. Untuk grup, Anda perlu mengetahui nama grup tersebut.";
"tour_section_4_title_2" = "Pencarian Cepat";
"tour_section_4_text_4" = "Untuk menghemat waktu, gunakan bilah pencarian di header situs.";
"tour_section_5_title_1" = "Unggah dan Bagikan Video kepada Teman Anda!";
"tour_section_5_text_1" = "Anda dapat mengunggah video dan klip dalam jumlah tak terbatas.";
"tour_section_5_text_2" = "Atur bagian “Video” melalui pengaturan privasi.";
"tour_section_5_bottom_text_1" = "Unggah video langsung ke dinding tanpa melalui bagian “Video”:";
"tour_section_5_title_2" = "Impor Video dari YouTube";
"tour_section_5_text_3" = "Selain mengunggah secara langsung, situs ini juga mendukung penyematan video dari YouTube.";
"tour_section_6_title_1" = "Dengarkan musik";
"tour_section_6_text_1" = "Anda dapat mendengarkan musik di “Audio Saya”";
"tour_section_6_text_2" = "Bagian ini juga diatur melalui pengaturan privasi.";
"tour_section_6_text_3" = "Lagu yang paling sering didengarkan ada di “Populer”, sedangkan lagu yang baru diunggah ada di “Baru”";
"tour_section_6_text_4" = "Untuk menambahkan lagu ke koleksi, arahkan kursor ke lagu tersebut lalu klik tanda “plus”. Anda dapat mencari lagu yang diinginkan.";
"tour_section_6_text_5" = "Jika tidak dapat menemukan lagu yang diinginkan, Anda dapat mengunggahnya sendiri";
"tour_section_6_bottom_text_1" = "<b>Penting:</b> lagu tersebut tidak boleh melanggar hak cipta";
"tour_section_6_title_2" = "Buat playlist";
"tour_section_6_text_6" = "Anda dapat membuat playlist di tab “Playlist Saya”";
"tour_section_6_text_7" = "Anda juga dapat menambahkan playlist milik orang lain ke koleksi Anda";
"tour_section_7_title_1" = "Ikuti tulisan teman-teman Anda";
"tour_section_7_text_1" = "Bagian “Berita Saya” terbagi menjadi dua jenis: umpan lokal dan umpan global";
"tour_section_7_text_2" = "Umpan lokal hanya menampilkan berita dari teman dan grup Anda";
"tour_section_7_bottom_text_1" = "Tidak ada sistem rekomendasi. <b>Anda sendiri yang menentukan umpan berita Anda</b>";
"tour_section_8_title_1" = "Jelajahi Diskusi di Seluruh Situs";
"tour_section_8_text_1" = "Umpan berita global menampilkan kiriman dari semua pengguna dan grup di situs.";
"tour_section_8_text_2" = "Catatan: Harap berhati-hati saat melihatnya karena bagian ini mungkin berisi konten yang tidak sesuai untuk orang yang sensitif.";
"tour_section_8_bottom_text_1" = "Desain umpan global identik dengan umpan lokal.";
"tour_section_8_bottom_text_2" = "Umpan ini mencakup berbagai jenis konten, termasuk foto biasa, video, kiriman anonim, dan jajak pendapat.";
"tour_section_9_title_1" = "Buat Grup!";
"tour_section_9_text_1" = "Jelajahi ribuan grup di situs ini yang membahas beragam topik dan komunitas penggemar.";
"tour_section_9_text_2" = "Bergabunglah dengan grup apa pun yang menarik bagi Anda. Jika tidak menemukan grup yang sesuai, silakan buat grup sendiri.";
"tour_section_9_text_3" = "Setiap grup memiliki bagian khusus untuk halaman wiki, album foto, blok tautan, dan forum diskusi.";
"tour_section_9_title_2" = "Kelola Grup Anda Bersama Teman";
"tour_section_9_text_2_1" = "Buka bagian “Edit Grup” di bawah avatar komunitas untuk mengelola grup Anda.";
"tour_section_9_text_2_2" = "Bentuk tim administrator dari peserta biasa atau orang-orang yang Anda percaya.";
"tour_section_9_text_2_3" = "Anda dapat menyembunyikan administrator tertentu agar mereka tetap tidak terlihat di dalam grup.";
"tour_section_9_bottom_text_1" = "Temukan bagian “Grup Saya” di menu sebelah kiri situs.";
"tour_section_9_bottom_text_2" = "Contoh Grup";
"tour_section_9_bottom_text_3" = "Grup sering kali mewakili organisasi nyata yang anggotanya ingin tetap terhubung dengan audiens mereka.";
"tour_section_10_title_1" = "Ups";
"tour_section_10_text_1" = "Saya akan sangat senang membuat tutorial tentang bagian ini, tetapi bagian tersebut masih dalam pengembangan. Untuk saat ini, mari kita lewati dan lanjutkan...";
"tour_section_11_title_1" = "Tema";
"tour_section_11_text_1" = "Setelah mendaftar, tema bawaan akan ditetapkan sebagai tampilan Anda.";
"tour_section_11_text_2" = "Sebagian pengguna baru mungkin menganggap tema bawaan saat ini agak ketinggalan zaman.";
"tour_section_11_text_3" = "<b>Jangan khawatir:</b> Anda dapat membuat tema sendiri dengan membaca <a href='https://openvk.org/dev'>dokumentasi</a> atau memilih salah satu dari katalog.";
"tour_section_11_bottom_text_1" = "Katalog tema tersedia di bagian “Pengaturan Saya”, pada tab “Antarmuka”.";
"tour_section_11_wordart" = "<img src='/assets/packages/static/openvk/img/tour/wordart_en.png' width='65%'>";
"tour_section_12_title_1" = "Latar Belakang Profil dan Grup";
"tour_section_12_text_1" = "Anda dapat menetapkan dua gambar sebagai latar belakang halaman.";
"tour_section_12_text_2" = "Gambar tersebut akan ditampilkan di sisi halaman bagi orang yang mengunjungi halaman Anda.";
"tour_section_12_text_3" = "<b>Petunjuk:</b> Sebelum menetapkan latar belakang, bereksperimenlah dengan tata letaknya—coba cerminkan gambar latar belakang yang akan digunakan atau buat gradasi yang menarik.";
"tour_section_12_title_2" = "Avatar";
"tour_section_12_text_2_1" = "Anda dapat memilih untuk menampilkan avatar pengguna dalam gaya standar, bulat, atau persegi (1:1).";
"tour_section_12_text_2_2" = "Pengaturan ini hanya terlihat oleh Anda.";
"tour_section_12_title_3" = "Mengedit Menu Sebelah Kiri";
"tour_section_12_text_3_1" = "Sembunyikan bagian situs yang tidak diperlukan jika perlu.";
"tour_section_12_text_3_2" = "<b>Ingat:</b> Bagian penting seperti Halaman Saya, Teman Saya, Jawaban Saya, dan Pengaturan Saya tidak dapat disembunyikan.";
"tour_section_12_title_4" = "Tampilan Kiriman";
"tour_section_12_text_4_1" = "Jika Anda bosan dengan desain dinding lama dari VKontakte asli yang pernah populer, ubah tampilan kiriman ke Microblog.";
"tour_section_12_text_4_2" = "Anda dapat beralih di antara kedua tampilan kiriman kapan saja.";
"tour_section_12_text_4_3" = "<b>Catatan:</b> Jika memilih tampilan kiriman lama, komentar terbaru tidak akan dimuat.";
"tour_section_12_bottom_text_1" = "Halaman Pengaturan Latar Belakang";
"tour_section_12_bottom_text_2" = "Contoh Halaman dengan Latar Belakang yang Telah Ditetapkan";
"tour_section_12_bottom_text_3" = "Tambahkan karakter pada profil Anda dengan fitur ini.";
"tour_section_12_bottom_text_4" = "Tampilan Kiriman Lama";
"tour_section_12_bottom_text_5" = "Microblog";
"tour_section_13_title_1" = "Kode Promosi";
"tour_section_13_text_1" = "OpenVK memiliki sistem kode promosi yang dirancang untuk menambahkan berbagai mata uang, seperti persentase peringkat, suara, dan lainnya.";
"tour_section_13_text_2" = "Kupon ini dibuat untuk acara penting dan hari libur. Ikuti <a href='https://t.me/openvk'>kanal Telegram OpenVK</a> untuk mendapatkan informasi terbaru.";
"tour_section_13_text_3" = "Setelah mengaktifkan kode promosi, mata uang yang ditentukan oleh administrator akan ditransfer ke akun Anda.";
"tour_section_13_text_4" = "<b>Ingat:</b> Semua kode promosi memiliki masa aktivasi terbatas.";
"tour_section_13_bottom_text_1" = "Kode promosi terdiri dari 24 angka dan huruf.";
"tour_section_13_bottom_text_2" = "Sebagai contoh, aktivasi berhasil akan memberikan 100 suara.";
"tour_section_13_bottom_text_3" = "<b>Perhatian:</b> Setelah kode promosi diaktifkan di halaman Anda, kode yang sama tidak dapat diaktifkan kembali.";
"tour_section_14_title_1" = "Versi Seluler";
"tour_section_14_text_1" = "Saat ini belum tersedia versi web seluler untuk situs ini, tetapi tersedia aplikasi seluler Android.";
"tour_section_14_text_2" = "OpenVK Legacy adalah aplikasi seluler OpenVK yang dirancang untuk perangkat Android retro, dengan desain aplikasi VKontakte 3.0 asli dari tahun 2013.";
"tour_section_14_text_3" = "Versi minimum yang didukung adalah Android 2.1 Eclair, sehingga perangkat dari awal tahun 2010-an masih cukup berguna.";
"tour_section_14_title_2" = "Di Mana Mengunduhnya?";
"tour_section_14_text_2_1" = "Versi rilis dapat diunduh melalui repositori F-Droid resmi.";
"tour_section_14_text_2_2" = "Jika Anda merupakan penguji beta, versi aplikasi baru akan dipublikasikan di kanal pembaruan terpisah.";
"tour_section_14_text_2_3" = "<b>Catatan:</b> Aplikasi ini mungkin memiliki berbagai bug dan masalah. Jika Anda menemukan kesalahan, laporkan kepada <a href='/app'>grup aplikasi resmi</a>.";
"tour_section_14_bottom_text_1" = "Tangkapan Layar";
"tour_section_14_bottom_text_2" = "Tur situs ini telah selesai. Jika Anda tertarik mencoba aplikasi seluler kami, membuat grup, mengundang teman, atau sekadar bersenang-senang, Anda dapat melakukannya sekarang dengan <a href='/reg'>mendaftar</a> secara cepat.";
"tour_section_14_bottom_text_3" = "Tur situs ini telah selesai.";
