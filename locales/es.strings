"error_no_event_name" = "No has introducido el nombre del evento o la fecha de inicio.";
"tour_section_2_text_1_1" = "Después de registrarte, serás redirigido automáticamente a <b>tu</b> perfil.";
"tour_section_2_text_1_2" = "Puedes editarlo en cualquier momento y desde cualquier lugar.";
"tour_section_2_text_1_3" = "<b>Consejo:</b> Para que tu perfil luzca mejor, completa tu información o sube una foto que refleje tu personalidad.";
"tour_section_2_bottom_text_1" = "Tú decides cuánta información quieres compartir con tus amigos.";
"tour_section_2_title_2" = "Configura tu privacidad";
"tour_section_2_text_2_1" = "Define quién puede acceder a determinados tipos de información y secciones de tu perfil.";
"tour_section_2_text_2_2" = "También puedes impedir que los motores de búsqueda y los usuarios no registrados accedan a tu perfil.";
"tour_section_2_text_2_3" = "<b>Recuerda:</b> Las opciones de privacidad seguirán ampliándose en el futuro.";
"tour_section_2_title_3" = "URL del perfil";
"tour_section_2_text_3_1" = "Después de registrarte, tu perfil recibe un ID personal como <b>@id12345</b>.";
"tour_section_2_text_3_2" = "El <b>ID predeterminado</b> asignado al registrarte <b>no puede cambiarse</b>.";
"tour_section_2_text_3_3" = "Sin embargo, en la configuración de tu perfil puedes asignar una dirección personalizada que <b>sí puede cambiarse</b> en cualquier momento.";
"tour_section_2_text_3_4" = "<b>Consejo:</b> Elige una dirección de al menos 5 caracteres para tener una URL atractiva. :)";
"tour_section_2_bottom_text_2" = "<i>Se admiten direcciones cortas con letras minúsculas del alfabeto latino; también pueden incluir números (no al principio), puntos y guiones bajos (no al principio ni al final).</i>";
"tour_section_2_title_4" = "Muro";
"tour_section_3_title_1" = "Comparte tus mejores momentos en fotos";
"tour_section_3_text_1" = "La sección «Fotos» estará disponible en tu perfil en cuanto completes el registro.";
"tour_section_3_text_2" = "Explora los álbumes de fotos de otros usuarios y crea los tuyos.";
"tour_section_3_text_3" = "Controla quién puede acceder a tus álbumes desde la configuración de privacidad de tu perfil.";
"tour_section_3_bottom_text_1" = "Crea una cantidad ilimitada de álbumes para tus viajes, eventos o simplemente para guardar memes.";
"tour_section_4_title_1" = "Búsqueda";
"tour_section_4_text_1" = "La sección «Buscar» te permite encontrar usuarios y grupos.";
"tour_section_4_text_2" = "Esta sección seguirá mejorando con el tiempo.";
"tour_section_4_text_3" = "Para buscar un usuario necesitas conocer su nombre o apellido. Para buscar un grupo, necesitas conocer su nombre.";
"tour_section_4_title_2" = "Búsqueda rápida";
"tour_section_4_text_4" = "Para ahorrar tiempo, utiliza la barra de búsqueda en la parte superior del sitio.";
"tour_section_5_title_1" = "¡Sube y comparte videos con tus amigos!";
"tour_section_5_text_1" = "Puedes subir una cantidad ilimitada de videos y clips.";
"tour_section_5_text_2" = "Controla el acceso a la sección «Videos» desde la configuración de privacidad.";
"tour_section_5_bottom_text_1" = "También puedes publicar videos directamente en el muro sin necesidad de usar la sección «Videos»:";
"tour_section_5_title_2" = "Importar videos desde YouTube";
"tour_section_5_text_3" = "Además de subir videos directamente, el sitio también permite insertar videos desde YouTube.";
"tour_section_6_title_1" = "Escucha música";
"tour_section_6_text_1" = "Puedes escuchar música en «Mis audios»";
"tour_section_6_text_2" = "Esta sección también está controlada por la configuración de privacidad.";
"tour_section_6_text_3" = "Las canciones más escuchadas se encuentran en «Populares» y las más recientes en «Nuevas»";
"tour_section_6_text_4" = "Para agregar una canción a tu colección, coloca el cursor sobre ella y haz clic en el botón «+». También puedes buscar la canción que desees.";
"tour_section_6_text_5" = "Si no encuentras la canción que buscas, puedes subirla tú mismo";
"tour_section_6_bottom_text_1" = "<b>Importante:</b> La canción no debe infringir derechos de autor";
"tour_section_6_title_2" = "Crea listas de reproducción";
"tour_section_6_text_6" = "Puedes crear listas de reproducción en la pestaña «Mis listas de reproducción»";
"tour_section_6_text_7" = "También puedes agregar las listas de reproducción de otros usuarios a tu colección";
"tour_section_7_title_1" = "Sigue lo que publican tus amigos";
"tour_section_7_text_1" = "La sección &quot;Mis noticias&quot; se divide en dos tipos: feed local y feed global";
"tour_section_7_text_2" = "El feed local solo mostrará las publicaciones de tus amigos y grupos";
"tour_section_7_bottom_text_1" = "No hay un sistema de recomendaciones. <b>Tú decides cómo construir tu propio feed de noticias</b>";
"tour_section_8_title_1" = "Explora las publicaciones de toda la comunidad";
"tour_section_8_text_1" = "El feed global muestra las publicaciones de todos los usuarios y grupos del sitio.";
"tour_section_8_text_2" = "Ten en cuenta que esta sección puede contener contenido no apto para personas sensibles.";
"tour_section_8_bottom_text_1" = "El diseño del feed global es idéntico al del feed local.";
"tour_section_8_bottom_text_2" = "El feed incluye diferentes tipos de contenido, como fotos, videos, publicaciones anónimas y encuestas.";
"tour_section_9_title_1" = "¡Crea grupos!";
"tour_section_9_text_1" = "Explora miles de grupos sobre distintos temas y comunidades de fans.";
"tour_section_9_text_2" = "Únete a cualquier grupo que te interese y, si no encuentras uno adecuado, crea el tuyo.";
"tour_section_9_text_3" = "Cada grupo cuenta con su propia sección de páginas wiki, álbumes de fotos, enlaces y foros de discusión.";
"tour_section_9_title_2" = "Administra tu grupo con tus amigos";
"tour_section_9_text_2_1" = "Para administrar tu grupo, abre la sección &quot;Editar grupo&quot; desde el avatar de la comunidad.";
"tour_section_9_text_2_2" = "Forma un equipo de administradores con participantes habituales o personas de tu confianza.";
"tour_section_9_text_2_3" = "También puedes ocultar administradores específicos para que no aparezcan públicamente en tu grupo.";
"tour_section_9_bottom_text_1" = "Puedes encontrar la sección &quot;Mis grupos&quot; en el menú lateral del sitio.";
"tour_section_9_bottom_text_2" = "Grupo de ejemplo";
"tour_section_9_bottom_text_3" = "Muchos grupos representan organizaciones reales cuyos miembros desean mantenerse en contacto con su comunidad.";
"tour_section_10_title_1" = "Ups...";
"tour_section_10_text_1" = "Me encantaría mostrarte un recorrido por esta sección, pero todavía está en desarrollo. Por ahora la omitiremos y continuaremos...";
"tour_section_11_title_1" = "Temas";
"tour_section_11_text_1" = "Después de registrarte, se aplicará el tema predeterminado.";
"tour_section_11_text_2" = "Es posible que algunos usuarios nuevos consideren que el tema predeterminado tiene un aspecto algo clásico.";
"tour_section_11_text_3" = "<b>No te preocupes:</b> Puedes crear tu propio tema consultando la <a href='https://openvk.org/dev'>documentación</a> o elegir uno del catálogo.";
"tour_section_11_bottom_text_1" = "El catálogo de temas está disponible en «Mi configuración», en la pestaña «Interfaz».";
"tour_section_11_wordart" = "<img src='/assets/packages/static/openvk/img/tour/wordart_es.png' width='65%'>";
"tour_section_12_title_1" = "Fondos para perfiles y grupos";
"tour_section_12_text_1" = "Puedes establecer dos imágenes como fondo de tu perfil.";
"tour_section_12_text_2" = "Se mostrarán a ambos lados para quienes visiten tu perfil.";
"tour_section_12_text_3" = "<b>Consejo:</b> Antes de configurar el fondo, prueba diferentes diseños: por ejemplo, reflejar la imagen o crear un degradado atractivo.";
"tour_section_12_title_2" = "Avatares";
"tour_section_12_text_2_1" = "Puedes elegir mostrar los avatares en formato estándar, redondeado o cuadrado (1:1).";
"tour_section_12_text_2_2" = "Estas opciones solo son visibles para ti.";
"tour_section_12_title_3" = "Editar el menú lateral";
"tour_section_12_text_3_1" = "Oculta las secciones del sitio que no necesites.";
"tour_section_12_text_3_2" = "<b>Recuerda:</b> Las secciones principales, como Mi perfil, Mis amigos, Mis respuestas y Mi configuración, no se pueden ocultar.";
"tour_section_12_title_4" = "Vista de las publicaciones";
"tour_section_12_text_4_1" = "Si ya te cansó el diseño clásico del muro del antiguo VKontakte, puedes cambiar la vista de las publicaciones al estilo Microblog.";
"tour_section_12_text_4_2" = "Puedes cambiar entre ambos estilos de publicaciones en cualquier momento.";
"tour_section_12_text_4_3" = "<b>Nota:</b> Si eliges la vista clásica, los comentarios más recientes no se cargarán automáticamente.";
"tour_section_12_bottom_text_1" = "Configuración del fondo";
"tour_section_12_bottom_text_2" = "Ejemplos de perfiles con fondo personalizado";
"tour_section_12_bottom_text_3" = "Dale más personalidad a tu perfil con esta función.";
"tour_section_12_bottom_text_4" = "Vista clásica de las publicaciones";
"tour_section_12_bottom_text_5" = "Microblog";
"tour_section_13_title_1" = "Códigos promocionales";
"tour_section_13_text_1" = "OpenVK cuenta con un sistema de códigos promocionales que permite obtener diferentes recompensas, como rating, votos y más.";
"tour_section_13_text_2" = "Estos códigos se crean para eventos importantes y festividades. Mantente al día siguiendo el <a href='https://t.me/openvk'>canal de OpenVK en Telegram</a>.";
"tour_section_13_text_3" = "Al activar un código promocional, recibirás en tu cuenta la recompensa que hayan definido los administradores.";
"tour_section_13_text_4" = "<b>Recuerda:</b> Todos los códigos promocionales tienen un período de validez limitado.";
"tour_section_13_bottom_text_1" = "Los códigos promocionales constan de 24 letras y números.";
"tour_section_13_bottom_text_2" = "Por ejemplo, una activación exitosa puede otorgarte 100 votos.";
"tour_section_13_bottom_text_3" = "<b>Atención:</b> Una vez que un código promocional se activa en tu cuenta, no puede volver a utilizarse.";
"tour_section_14_title_1" = "Versión móvil";
"tour_section_14_text_1" = "Actualmente no existe una versión web para móviles, pero sí una aplicación para Android.";
"tour_section_14_text_2" = "OpenVK Legacy es una aplicación móvil de OpenVK para dispositivos Android antiguos, inspirada en el diseño de la aplicación original de VKontakte 3.0 de 2013.";
"tour_section_14_text_3" = "La versión mínima compatible es Android 2.1 Eclair, por lo que incluso los dispositivos de principios de la década de 2010 siguen siendo compatibles.";
"tour_section_14_title_2" = "¿Dónde descargarla?";
"tour_section_14_text_2_1" = "Las versiones estables pueden descargarse desde el repositorio oficial de F-Droid.";
"tour_section_14_text_2_2" = "Si eres beta tester, las nuevas versiones se publican en un canal de actualizaciones independiente.";
"tour_section_14_text_2_3" = "<b>Nota:</b> La aplicación puede contener errores. Si encuentras alguno, repórtalo en el <a href='/app'>grupo oficial de la aplicación</a>.";
"tour_section_14_bottom_text_1" = "Capturas de pantalla";
"tour_section_14_bottom_text_2" = "Con esto termina el recorrido por el sitio. Si quieres probar nuestra aplicación móvil, crear un grupo, invitar a tus amigos o simplemente divertirte, puedes hacerlo registrándote <a href='/reg'>aquí</a>.";
"tour_section_14_bottom_text_3" = "Aquí termina el recorrido por el sitio.";
