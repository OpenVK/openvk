"tour_section_1_title_1" = "¿Por dónde empezar?";
"tour_section_1_text_1" = "Crear una cuenta es el primer paso para comenzar a usar este sitio.";
"tour_section_1_text_2" = "Para registrarte solo necesitas introducir tu nombre, correo electrónico y contraseña.";
"tour_section_1_text_3" = "<b>Recuerda:</b> tu correo electrónico será tu usuario para iniciar sesión. También puedes optar por no indicar tu apellido al registrarte. Si olvidas tu contraseña, utiliza la <a href='/restore'>página de recuperación</a>";
"tour_section_1_bottom_text_1" = "Al registrarte en el sitio, aceptas las <a href='/terms'>reglas del sitio</a> y la <a href='/privacy'>política de privacidad</a>";
