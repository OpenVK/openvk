includes:
    - vendor/efabrica/phpstan-latte/rules.neon

parameters:
    level: 1
    paths:
        - bin
        - CLI
        - Email
        - ServiceAPI
        - VKAPI
        - Web
        - bootstrap.php
        - openvkctl
        - chandler_loader.php
    
    bootstrapFiles:
        - chandler_loader.php
        - phpstan-bootstrap.php

    # OPENVK_ROOT_CONF is a runtime config constant. Keep it generic so PHPStan
    # does not depend on the local openvk.yml; key parity is checked by the
    # configs sanity job.
    dynamicConstantNames:
        CHANDLER_ROOT_CONF: 'array<string, mixed>'
        OPENVK_ROOT_CONF: 'array<string, mixed>'
        CONNECTING_IP: string
        VKAPI_DECL_VER: string
        VKAPI_OVK_APP: string
        VKAPI_DECL_VER_MAJOR: int
        VKAPI_DECL_VER_MINOR: int

    tmpDir: tmp/phpstan

    earlyTerminatingMethodCalls:
        Chandler\MVC\SimplePresenter:
            - redirect
            - terminate
            - throwError
            - notFound
            - pass
        openvk\Web\Presenters\OpenVKPresenter:
            - flashFail

    # ../chandler is collected for presenter-wide variables (SimplePresenter::onBeforeRender),
    # its error pages are rendered through dynamic expressions the analyser cannot resolve.
    ignoreErrors:
        -
            message: '#^Cannot automatically resolve latte template from expression\.$#'
            path: '*/chandler/MVC/SimplePresenter.php'

    latte:
        engineBootstrap: tools/phpstan-latte/latte.engine.php
        tmpDir: tmp/phpstan-latte
        reportUnanalysedTemplates: true
        # Kept low on purpose: @layout alone has 129 variants (one per presenter).
        # The "Skipped N variant(s)" warnings are expected and intentional.
        maxTemplateVariants: 2
        breakIncludeCycles: true
        collectedPaths:
            - vendor/openvk/chandler/chandler/MVC/SimplePresenter.php
        globalVariables:
            parentModule: 'string|null'
            backdrops: 'array<int, string>|null'
            club: '\openvk\Web\Models\Entities\Club|null'
            title: 'string|null'
            commentSection: 'bool|null'
            post: '\openvk\Web\Models\Entities\Post|null'
            owner: 'int|\openvk\Web\Models\Entities\User|null'
            custom_id: 'int|string|null'
            iterator: 'iterable'
            # @listView.latte passes the current list item into blocks as "x => $dat"
            x: 'mixed'
        errorPatternsToIgnore:
            # Notification/Feed.latte includes notification templates dynamically
            - '/^Cannot resolve included latte template\.$/'

        templateTypes:
            - Chandler\MVC\TemplateScope
        features:
            analyseLayoutFiles: true
            phpstanCommand: "vendor/bin/phpstan analyse {dir} --no-progress --memory-limit 512M -c phpstan-latte-inner.neon"

    parallel:
        maximumNumberOfProcesses: 1

services:
    - Chandler\PHPStanLatte\ChandlerPresenterTemplateResolver
    - Chandler\PHPStanLatte\ChandlerErrorTemplateResolver
    - openvk\PHPStanLatte\EmailTemplateResolver
    - openvk\PHPStanLatte\NotificationTemplateResolver

