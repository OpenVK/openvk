{extends "../@layout.latte"}

{block layout_width}925px{/block}

{block title}{$heading}{/block}

{block header}
    {$heading}
	{css "css/dev.css"}
{/block}

{block sidebar}
    <div class="dev_sidebar_menu">
        {define isLinkActive, $href, $current}
            {var $cleanHref = ltrim(preg_replace('#^/?(dev/)?#', '', $href), '/')}
            {var $cleanCurrent = ltrim(preg_replace('#^/?(dev/)?#', '', $current), '/')}
            {$cleanHref === $cleanCurrent}
        {/define}

        {if !empty($isMethodsPage)}
            <a href="/dev" data-do-ajax="true" class="link dev_section_link dev_back_link">
                {tr("dsb_back_to_docs")}
            </a>

            <div class="dev_sidebar_separator"></div>

            <a 
                href="/dev/methods/execute"
                data-do-ajax="true"
                class="link dev_section_link {if $currentSection === 'methods/execute'}active dev_mlist_sel{/if}"
                style="margin-bottom: 6px;"
            >
                execute
            </a>

            {foreach $methodsGroups as $group}
                {var $isGroupOpen = str_starts_with($currentSection, 'methods/' . $group['id'])}
                
                <div class="fictional_profile_section">
                    <div 
                        class="{if $isGroupOpen}content_title_expanded{else}content_title_unexpanded{/if}" 
                        onclick="hidePanel(this);"
                    >
                        {tr($group['name'])}
                    </div>
                    
                    <div id="dev_group_{$group['id']}" {if !$isGroupOpen}style="display: none;"{/if}>
                        {foreach $group['links'] as $item}
                            {var $isActive = ltrim(preg_replace('#^/?(dev/)?#', '', $item['href']), '/') === ltrim(preg_replace('#^/?(dev/)?#', '', $currentSection), '/')}
                            
                            <a 
                                href="{$item['href']}"
                                data-do-ajax="true"
                                class="link dev_section_link dev_sublink {if $isActive}active dev_mlist_sel{/if}"
                            >
                                {$item['name']}
                            </a>
                        {/foreach}
                    </div>
                </div>
            {/foreach}
        {elseif !empty($isModelsPage)}
            <a href="/dev" data-do-ajax="true" class="link dev_section_link dev_back_link">
                {tr("dsb_back_to_docs")}
            </a>

            <div class="dev_sidebar_separator"></div>

            {foreach $modelsList as $item}
                {var $isActive = ltrim(preg_replace('#^/?(dev/)?#', '', $item['href']), '/') === ltrim(preg_replace('#^/?(dev/)?#', '', $currentSection), '/')}
                
                <a 
                    href="{$item['href']}"
                    data-do-ajax="true"
                    class="link dev_section_link dev_sublink {if $isActive}active dev_mlist_sel{/if}"
                >
                    {$item['name']}
                </a>
            {/foreach}

        {else}
            {foreach $devMenu as $item}
                {var $itemPath = trim($item['href'], '/')}
                {var $curPath  = trim($currentSection, '/')}
                {var $isActive = ($curPath === '' || $curPath === 'dev') 
                    ? ($itemPath === 'dev') 
                    : ($itemPath === $curPath || $itemPath === 'dev/' . $curPath)}

                <a 
                    href="{$item['href']}"
                    data-do-ajax="true"
                    class="link dev_section_{$item['type']} {if $isActive}active dev_mlist_sel{/if}"
                >
                    {tr($item['name'])}
                </a>
            {/foreach}
        {/if}
    </div>
{/block}

{block wrap}
<div class="wrap2">
	<div class="wrap1">
		<div class="dev_wrap">
			<div class="dev_page_cont">
				{$content|noescape}
			</div>
		</div>
	</div>
</div>
{/block}