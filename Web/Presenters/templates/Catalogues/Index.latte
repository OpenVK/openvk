{extends "../@layout.latte"}

{block title}{_catalogues}{/block}

{block header}
    {_catalogues}
{/block}

{block content}
    <div class="tabs">
        {foreach $acts as $tab}
            <div n:attr="id => ($tab[0] == $act ? 'activetabs' : 'ki')" class="tab">
                <a n:attr="id => ($tab[0] == $act ? 'act_tab_a' : 'ki')" href="/catalogues?act={$tab[0]}">{$tab[1]}</a>
            </div>
        {/foreach}
    </div>
    <div id="catalogues_list">
        <ul>
            <li><a class="catalogue_item" href="/fave">{_bookmarks_tab}</a></li>
            <li><a class="catalogue_item" href="/search?section=posts&from_me=1">{_own_posts_tab}</a></li>

        {foreach $catalogues as $item}
            <li><a class="catalogue_item" href="/fave">{$item->getTitle()}</a></li>
        {/foreach}
        </ul>
    </div>
{/block}
