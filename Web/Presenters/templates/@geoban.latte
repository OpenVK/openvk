{extends "@layout.latte"}
{block title}{_unavailable_in_your_region}{/block}

{block header}
    {_unavailable_in_your_region}
{/block}

{block content}
<center>
    <img src="/assets/packages/static/openvk/img/oof.apng" style="width: 20%;" />
    <p>
        {if $thisUser && $thisUser->isAdmin()}
            <a href="/admin/geoblock/id{$ban->getId()}">{tr("unavailable_in_your_region_desc_less")}</a>
        {else}
            <a href="/admin/geoblock/id{$ban->getId()}">{tr("unavailable_in_your_region_desc", $country, $ban->getReason(), $ban->getTime())}</a>
        {/if}
    </p>
</center>

{/block}
