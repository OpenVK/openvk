{extends "../@listView.latte"}
{var $iterator = $followers}
{var $count    = $paginatorConf->count}
{var $page     = $paginatorConf->page}
{var $perPage  = 6}

{block title}{_followers} {$club->getCanonicalName()}{/block}

{block header}
    <a href="{$club->getURL()}">{$club->getCanonicalName()}</a>
    » {_req}
{/block}

{* BEGIN ELEMENTS DESCRIPTION *}

{block tabs}
	{if $club->canBeModifiedBy($thisUser)}
		<div class="tab">
			<a href="/club{$club->getId()}/edit">
				{_main}
			</a>
		</div>
        <div class="tab">
            <a href="/club{$club->getId()}/backdrop">
                {_backdrop_short}
            </a>
        </div>
	{/if}
    <div class="tab">
        <a id="ki" href="/club{$club->getId()}/followers">
            {_followers}
        </a>
    </div>
    <div id="activetabs" class="tab">
        <a id="act_tab_a" href="/club{$club->getId()}/followers/req">
            {_req}
        </a>
    </div>
{/block}

{block link|strip|stripHtml}
    /id{$x->getId()}
{/block}

{block preview}
    <img src="{$x->getAvatarURL('miniscule')}" alt="{$x->getCanonicalName()}" width=75 />
{/block}

{block name}
    {$x->getCanonicalName()}
{/block}

{block description}
    {var $user = $x}
    <table class="flexible_table list_view_item_info">
        <tbody>
            <tr>
                <td width="120" valign="top"><span class="nobold">{_pronouns}: </span></td>
                <td>{$user->isFemale() ? tr("female") : ($user->isNeutral() ? tr("neutral") : tr("male"))}</td>
            </tr>
            <tr>
                <td width="120" valign="top"><span class="nobold">{_registration_date}: </span></td>
                <td>{$user->getRegistrationTime()}</td>
            </tr>
        </tbody>
    </table>
{/block}

{block actions}
    {var $user = $x}
    {if $club->canBeModifiedBy($thisUser ?? NULL)}
        <a class="profile_link" href="/club{$club->getId()}/setFlag?user={$user->getId()}&accept=1&hash={rawurlencode($csrfToken)}">
            {_friends_accept}
        </a>
        <a class="profile_link" href="/club{$club->getId()}/setFlag?user={$user->getId()}&accept=0&hash={rawurlencode($csrfToken)}">
            {_friends_reject}
        </a>
    {/if}
{/block}
